# Copy this file to .env for local development (.env is gitignored).
# On Azure, set the same names under the App Service's Environment variables.

# Base URL of the ECommerceApi backend, including /api
API_BASE_URL=https://localhost:7224/api

# Stripe publishable key (pk_test_... or pk_live_...). Must be the same
# Stripe account and mode as the backend's Stripe:SecretKey.
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
